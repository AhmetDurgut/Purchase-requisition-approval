//----------------------------------------------------------------------
// Behavior Definition: ZI_PR_HEADER_AD
// Purpose: Managed RAP behavior for Purchase Requisition (header +
//          item, with draft)
// Target:  SAP BTP ABAP Environment / S/4HANA (ABAP Cloud)
//
// Note: implementation class is ZBP_I_PR_HEADER_AD (uses the Local
//       Handler Class / LHC pattern - see that file's header comment)
// Note: draft is enabled; ADT auto-generates the draft tables
//       (zpr_header_ad_d, zpr_item_ad_d) on activation via the Quick
//       Fix offered on the "draft table" lines below
// Note: 4 actions (approve / reject(parameter) / requestInfo / submit)
//       plus the determine action recalcTotal, 3 validations,
//       determinations for requester, numbering, total, and approval
//       data on the header; item numbering, item currency default, and
//       item amount calculation on the item
// Note: calculateTotal triggers "on save" (not "on modify") - its own
//       field trigger (TotalAmount) never fires on its own since
//       TotalAmount is readonly; it is force-run via the determine
//       action recalcTotal, invoked explicitly from calculateItemAmount
//----------------------------------------------------------------------
managed implementation in class zbp_i_pr_header_ad unique;
strict ( 2 );
with draft;

define behavior for ZI_PR_HEADER_AD alias PurchaseRequisition
persistent table zpr_header_ad
draft table zpr_header_ad_d
lock master
total etag LastChangedAt
authorization master ( instance )
etag master LocalLastChangedAt
{
  // technical key generated by RAP
  field ( numbering : managed, readonly ) PrUuid;

  // business key + calculated + status-driven fields are readonly;
  // RejectReason is readonly too - it is only ever set internally by
  // the reject action's parameter, never edited directly
  field ( readonly ) PrNumber, TotalAmount, Status, Approver, ApprovedAt, Requester, RejectReason;

  // required input
  field ( mandatory ) Description, CostCenter;

  // admin fields readonly
  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;

  create;
  update;
  delete;

  // composition to items
  association _Item { create; with draft; }

  // ---- Actions (all draft-enabled, instance feature-controlled) ----
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateAmount;
    validation validateItems;
    validation validateRejectReason;
  }

  action ( features : instance ) submit result [1] $self;
  action ( features : instance ) approve result [1] $self;
  action ( features : instance ) reject parameter ZA_PR_REJECT_AD result [1] $self;
  action ( features : instance ) requestInfo result [1] $self;

  // force-runs calculateTotal regardless of its own trigger condition;
  // called explicitly from LHC_PURCHASEREQUISITIONITEM=>calculateItemAmount
  // since TotalAmount is readonly and can never trigger it by itself
  determine action recalcTotal
  {
    determination ( always ) calculateTotal;
  }

  // ---- Validations ----
  validation validateAmount on save { create; update; field TotalAmount; }
  validation validateItems on save { create; update; }
  validation validateRejectReason on save { field Status, RejectReason; }

  // ---- Determinations ----
  determination setInitialStatus on modify { create; }
  determination setRequester on modify { create; }
  determination setPRNumber on modify { field Status; }
  determination calculateTotal on save { field TotalAmount; }
  determination setApprovalData on modify { field Status; }

  mapping for zpr_header_ad
  {
    PrUuid = pr_uuid;
    PrNumber = pr_number;
    Description = description;
    Requester = requester;
    CostCenter = cost_center;
    TotalAmount = total_amount;
    Currency = currency;
    Status = status;
    Approver = approver;
    ApprovedAt = approved_at;
    RejectReason = reject_reason;
    CreatedBy = created_by;
    CreatedAt = created_at;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

define behavior for ZI_PR_ITEM_AD alias PurchaseRequisitionItem
persistent table zpr_item_ad
draft table zpr_item_ad_d
lock dependent by _Header
authorization dependent by _Header
etag master LocalLastChangedAt
{
  update;
  delete;
  // ItemNumber and Currency are readonly - both are filled automatically
  // by determinations on create (setItemNumber, setItemCurrency), never
  // entered directly
  field ( readonly ) ParentUuid, Amount, Currency, ItemNumber;
  field ( mandatory ) Material, Quantity, Price;
  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;

  // numbering for item technical key
  field ( numbering : managed, readonly ) ItemUuid;

  association _Header { with draft; }

  // ---- Determinations ----
  // assigns the next line number (10, 20, 30, ...) among the sibling
  // items of the same header
  determination setItemNumber on modify { create; }
  // copies the parent header's Currency, so Price/Amount always carry a
  // currency consistent with the header's TotalAmount/Currency
  determination setItemCurrency on modify { create; }
  determination calculateItemAmount on modify { field Quantity, Price; }

  mapping for zpr_item_ad
  {
    ItemUuid = item_uuid;
    ParentUuid = parent_uuid;
    ItemNumber = item_number;
    Material = material;
    Description = description;
    Quantity = quantity;
    Unit = unit;
    Price = price;
    Amount = amount;
    Currency = currency;
    CreatedBy = created_by;
    CreatedAt = created_at;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}
